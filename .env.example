# Sao chép file này thành .env rồi sửa cho phù hợp.

# Cổng máy chủ game. Nginx sẽ chuyển tiếp từ cổng 80/443 về đây.
PORT=3000

# 127.0.0.1 = chỉ Nginx trên cùng VPS mới gọi được (an toàn hơn).
# Đổi thành 0.0.0.0 nếu muốn chạy thử trực tiếp qua http://IP-VPS:3000
HOST=127.0.0.1

# Tên tài khoản sẽ tự thành Admin khi đăng ký. Tài khoản đầu tiên tạo trên máy chủ cũng tự thành Admin.
ADMIN_USERNAME=

# Đường dẫn file database (mặc định: data/aetherfall.db)
# DB_FILE=/home/aetherfall/app/data/aetherfall.db

# Lời chào hiện trong khung chat khi vào game
MOTD=Chào mừng tới Aetherfall! Gõ /help trong khung chat để xem lệnh.

# Để 1 khi chạy sau Nginx (lấy đúng IP người chơi). Đặt 0 nếu không dùng Nginx.
TRUST_PROXY=1
